import java.util.Scanner;

public class prb5 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        for(int i = 1; i <= n; i++) {
            int odd = 1;
            for(int j = 1; j <= n; j++) {
                System.out.print(odd + " ");
                odd += 2;
            }
            System.out.println();
        }
    }
}
